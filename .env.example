# Azure Infra World Map — backend configuration
# Copy this file to .env and adjust. All values are OPTIONAL for read-only mode.
#
# Auth uses DefaultAzureCredential: locally it reuses your Azure CLI session
# (run `az login`); in Azure (App Service / Container Apps) it uses the host's
# Managed Identity. It never stores credentials and only performs read-only calls.

# API server port. The Vite dev server runs on 8084 and proxies /api to this port.
PORT=8085

# Default subscription to load on startup (falls back to your az CLI default,
# or seeds the picker when hosted under a Managed Identity).
# AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# (Cloud/optional) Scope the subscription picker to one tenant when running
# under a Managed Identity (where no Azure CLI is present on the host).
# AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# ---- Azure SQL cost cache (optional; enables throttle-resistant cost history) ----
# When set, cost data is cached in / served from Azure SQL instead of hitting
# the Cost Management API on every request. Auth is Entra (DefaultAzureCredential
# access token) — no SQL password required when the server uses Entra-only auth.
# SQL_SERVER=your-sql-server.database.windows.net
# SQL_DATABASE=infraworldmap
