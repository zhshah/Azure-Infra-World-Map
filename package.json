{
  "name": "azure-infra-world-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Azure Infra World Map — a real-time command center for your Azure estate (cost, security, health, governance, reliability) visualised on a live 3D globe and world map. Read-only, powered by live Azure APIs.",
  "author": "Zahir Hussain Shah <zahir@zahir.cloud> (https://www.zahir.cloud)",
  "license": "MIT",
  "homepage": "https://github.com/zhshah/Azure-Infra-World-Map#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhshah/Azure-Infra-World-Map.git"
  },
  "bugs": {
    "url": "https://github.com/zhshah/Azure-Infra-World-Map/issues"
  },
  "keywords": [
    "azure",
    "finops",
    "cost-management",
    "cloud-governance",
    "defender-for-cloud",
    "azure-advisor",
    "well-architected",
    "deck.gl",
    "dashboard",
    "visualization",
    "typescript"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.mjs",
    "dev:web": "vite",
    "api": "node server/index.mjs",
    "start": "node server/index.mjs",
    "build": "vite build",
    "preview": "vite preview --port 8082"
  },
  "dependencies": {
    "@azure/arm-costmanagement": "1.0.0-beta.1",
    "@azure/arm-managementgroups": "^2.0.2",
    "@azure/arm-resourcegraph": "^4.2.1",
    "@azure/arm-resources": "^7.0.0",
    "@azure/arm-resources-subscriptions": "^2.1.0",
    "@azure/identity": "^4.13.1",
    "@azure/monitor-query": "^1.3.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "mssql": "^12.6.0"
  },
  "devDependencies": {
    "@deck.gl/aggregation-layers": "^9.3.5",
    "@deck.gl/core": "^9.3.5",
    "@deck.gl/layers": "^9.3.5",
    "@deck.gl/mesh-layers": "^9.3.5",
    "@types/node": "^22.9.0",
    "concurrently": "^9.1.0",
    "topojson-client": "^3.1.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "world-atlas": "^2.0.2"
  }
}
